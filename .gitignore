# ---------------------------------------------
# 1. IGNORAR DATOS (Archivos grandes .parquet, .csv)
# Esto es CRUCIAL para evitar el error "remote end hung up unexpectedly"
# Al incluir la extensión, ignoras TODOS los archivos de datos de ese tipo.
*.parquet
*.csv
*.zip

# Opcional: Si tienes una carpeta de datos
# data/

# ---------------------------------------------
# 2. IGNORAR ARCHIVOS GENERADOS (Python/Jupyter)

# Ignorar directorios de paquetes compilados
__pycache__/

# Ignorar entornos virtuales (si usaste "venv" o "env")
venv/
env/

# Ignorar archivos generados por Jupyter (puntos de control)
.ipynb_checkpoints/

# Ignorar archivos de registro del IDE (Visual Studio Code, etc.)
.vscode/

# Ignorar el dataset final fusionado
df_final_credit_scoring_merged.parquet

# Ignorar la carpeta de datos fuente
datos_examen/